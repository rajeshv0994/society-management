# Copy this file to .env before running Docker Compose.
SPRING_PROFILES_ACTIVE=local
POSTGRES_DB=societydb
POSTGRES_USER=societyapp
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5433

BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8080
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION_DAYS=30
SUPER_ADMIN_EMAIL=admin@society.local
SUPER_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
SEED_DEMO_DATA=true

MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_SIZE=100MB
MAX_REQUEST_SIZE=105MB
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Enable with: docker compose --profile kafka up --build -d
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_NOTIFICATION_TOPIC=society.notifications.v1
KAFKA_DISPATCH_DELAY_MS=5000
KAFKA_BATCH_SIZE=50
KAFKA_MAX_ATTEMPTS=5
KAFKA_SEND_TIMEOUT_MS=10000
