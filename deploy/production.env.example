# Copy to /opt/societyhub/.env on the deployment host and replace every value.
# Never commit the real file.
# compose.production.yml activates the production Spring profile.
SPRING_DATASOURCE_URL=jdbc:postgresql://database-host:5432/societydb
SPRING_DATASOURCE_USERNAME=replace-me
SPRING_DATASOURCE_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION_DAYS=30
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-me-and-rotate-after-bootstrap
CORS_ALLOWED_ORIGINS=https://society.example.com
SPRINGDOC_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka-1.example.com:9093,kafka-2.example.com:9093
KAFKA_NOTIFICATION_TOPIC=society.notifications.v1
KAFKA_DISPATCH_DELAY_MS=5000
KAFKA_BATCH_SIZE=50
KAFKA_MAX_ATTEMPTS=5
KAFKA_SEND_TIMEOUT_MS=10000
MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_SIZE=100MB
MAX_REQUEST_SIZE=105MB
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
